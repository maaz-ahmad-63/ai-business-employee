# ==============================================================================
# PostgreSQL + pgvector
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=ai_platform

# ==============================================================================
# Embedding Configuration (Local BGE-M3)
# ==============================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZE=true
# EMBEDDING_DEVICE=cpu # or cuda, mps, auto

# ==============================================================================
# Reranker Configuration (Local Cross-Encoder)
# ==============================================================================
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATES=20
RERANKER_TOP_K=5
# RERANKER_DEVICE=cpu

# ==============================================================================
# Hybrid Search & Chunking
# ==============================================================================
RRF_K=60
DEFAULT_TOP_K=5
DEFAULT_CANDIDATE_K=20
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ==============================================================================
# MongoDB Analytics (Optional - Retrieval functions if empty)
# ==============================================================================
MONGODB_URL=
MONGODB_DATABASE=ai_platform
MONGODB_COLLECTION=rag_analytics

# ==============================================================================
# Pluggable LLM Configuration (Optional for /api/rag/ask)
# Supported providers: openai, anthropic, gemini, ollama, mock
# ==============================================================================
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
